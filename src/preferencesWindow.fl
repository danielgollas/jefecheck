              tooltip {When browsing for sequences, this will be the default folder the browser opens. Set it to point to the project folder you are currently working on to make browsing easier!} xywh {228 256 85 18} labelcolor 7 align 5 when 1
            }
          }
        }
      }
      Fl_Button {} {
        label {Save and Close}
        user_data PREFERENCESDONE_ID
        callback PreferencesCB
        tooltip {Closes this window without saving preferences for next session} xywh {210 545 130 35} box FLAT_BOX down_box PLASTIC_DOWN_BOX color 8 labelcolor 31
        code0 {\#include "Fl_Button_gfc.h"}
        class Fl_Button_gfc
      }
    }
  }
} 
