class GammaWindow {open : {public Fl_Double_Window}
} {
  decl {\#include "UIConstants.h"} {}
  decl {\#include "UICallbacks.h"} {}
  Function {GammaWindow(int x, int y, int wi, int height,const char* l) : Fl_Double_Window(300, 300, 300, 300, "Load Window")} {open
  } {
    Fl_Window gammaWindow {
      label {Gamma Adjustment}
      user_data LOADCLOSE_ID
      callback loadCB open selected
      xywh {777 404 840 610} type Double box NO_BOX color 56 labelcolor 17 size_range {840 610 840 610} visible
