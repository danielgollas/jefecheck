      Fl_Button doneButton {
        label Done
        user_data GAMMADONE_ID
        callback gammaCB
        xywh {744 578 64 17} color 0
      }
      Fl_Value_Slider gammaBar {
        label {Gamma:}
        user_data GAMMAGLOBAL_ID
        callback gammaCB
        xywh {195 472 617 20} type Horizontal labelcolor 31 align 4 maximum 2 value 1 textsize 14
      }
      Fl_Value_Slider gammaRBar {
        label {Red Gamma}
        user_data GAMMAGLOBAL_ID
        callback gammaCB
        xywh {197 512 614 20} type Horizontal labelcolor 31 align 4 maximum 2 value 1 textsize 14 deactivate
      }
      Fl_Value_Slider gammaGBar {
        label {Green Gamma}
        user_data GAMMAGLOBAL_ID
        callback gammaCB
        xywh {197 532 614 20} type Horizontal labelcolor 31 align 4 maximum 2 value 1 textsize 14 deactivate
      }
      Fl_Value_Slider gammaBBar {
        label {Blue Gamma}
        user_data GAMMAGLOBAL_ID
        callback gammaCB
        xywh {197 552 614 20} type Horizontal labelcolor 31 align 4 maximum 2 value 1 textsize 14 deactivate
      }
      Fl_Check_Button byColorCheckBox {
        label {By Color}
        user_data GAMMABYCOLOR_ID
