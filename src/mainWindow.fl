  Function {toggleFullscreen()} {open return_type void
  } {
    code {static int fsX, fsY, fsW, fsH;
	
	int controlsWhereHidden=0;
	
	 //if controls are hidden, show them briefly before going fullscreen
            if(controlsHidden)
            {
             controlsWhereHidden=1;
             toggleHideControls();
            }
            
	
	switch ( fullscreenActive ) {
        case 0:
        
        	
           
            fsX=mainWindow->x();
            fsY=mainWindow->y();
            fsW=mainWindow->w();
            fsH=mainWindow->h();

            mainWindow->fullscreen();
            fullscreenActive=1;
	

            break;
        case 1:

            mainWindow->fullscreen_off ( fsX,fsY,fsW,fsH );
            fullscreenActive=0;

            break;
        }
        
        
        //hide the controls again if they where hidden.
	    if(controlsWhereHidden)
	    {
	     toggleHideControls();
	    }} {}
  }
  Function {toggleHideControls(int force=-1)} {open return_type void
  } {
    code {static int vpPrevX,vpPrevY,vpPrevW, vpPrevH;
	static int cbGroupHeight=-1;
	static int menuBarHeight=-1;

    printf("toggle hide!\\n");
    
	//only run the first time
	if (cbGroupHeight==-1 && menuBarHeight==-1)
	{
		cbGroupHeight=controlBarGroup->h();
		menuBarHeight=menuBar->h();
	}
		
	if (controlsHidden || force==1) { //show the Controls


        menuBar->set_visible();
        controlBarGroup->set_visible();

		//mw.controlBarGroup->resize(0,mw.mainWindow->h(),mw.mainWindow->w(),cbGroupHeight);

		//mw.vp->resize(0,mw.menuBar->h(),mw.mainWindow->w(),mw.mainWindow->h()-mw.menuBar->h()-mw.controlBarGroup->h());
		vp->resize(0,menuBarHeight,mainWindow->w(),mainWindow->h()-menuBarHeight-cbGroupHeight);
		

        //mw.vp->resize ( vpPrevX,vpPrevY,vpPrevW,vpPrevH );


        controlBarGroup->redraw();
        Fl::redraw();
    } else { //hide the controls

        vpPrevX=vp->x();
        vpPrevY=vp->y();
        vpPrevW=vp->w();
        vpPrevH=vp->h();

        menuBar->hide();
        controlBarGroup->hide();

        //not cool for multi monitor //mw.vp->resize ( 0,0,glutGet ( GLUT_SCREEN_WIDTH ),glutGet ( GLUT_SCREEN_HEIGHT ) );

        vp->resize ( 0,0,mainWindow->w(),mainWindow->h());
    }

    controlsHidden=!controlsHidden;} {}
  }
} 
