<?xml version = '1.0' encoding = 'UTF-8'?>
<root comment="this is the root node" >
  <general Description="Squeeze two tracks side by side for stereo Monitors" menuName="Comp/Stereo SxS Squeeze" version="1.0" author="Daniel Gollas" name="SXSSqueeze" />
  <groups>
