<?xml version = '1.0' encoding = 'UTF-8'?>
<root comment="this is the root node" >
  <general Description="Composite two images using an Over operation" menuName="Comp/Over" version="2.0" author="Daniel Gollas" name="Over" />
  <groups>
    <group name="Parameters" >
      <widget type="newLine" varName="furstNeLine" />
      <widget labelColorR="255" labelColorB="255" type="texture" default="0" label="Bottom" labelColorG="255" varName="Bottom" />
      <widget labelColorR="155" labelColorB="155" type="texture" default="2" label="Matte" labelColorG="155" varName="Matte" />
      <widget labelColorR="255" labelColorB="255" type="texture" default="2" label="Top" labelColorG="255" varName="Top" />
      <widget type="newLine" varName="0" />
      <widget width="75" type="spacer" label="" varName="spacer1" />
      <widget labelColorR="255" labelColorB="255" type="choice" default="3" label="Method" labelColorG="255" varName="Method" >
        <choice type="choice" label="R" />
        <choice type="choice" label="G" />
        <choice type="choice" label="B" />
        <choice type="choice" label="A" />
        <choice type="choice" label="Y" />
        <choice type="choice" label="V" />
      </widget>
      <widget type="newLine" varName="lastNewLine" />
    </group>
  </groups>
  <shaders vertex="fixed.vert" fragment="OVER.frag" />
</root>
