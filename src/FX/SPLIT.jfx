<?xml version = '1.0' encoding = 'UTF-8'?>
<root comment="this is the root node" >
  <general Description="Split the frame between two images" menuName="Comp/Split" version="2.0" author="Daniel Gollas" name="Split" />
  <groups>
    <group name="Parameters" >
      <widget type="newLine" varName="0" />
      <widget labelColorR="255" labelColorB="255" type="texture" default="0" label="Image 1" labelColorG="255" varName="first" />
      <widget labelColorR="255" labelColorB="255" type="texture" default="2" label="Image 2" labelColorG="255" varName="second" />
      <widget type="newLine" varName="0" />
      <widget labelColorR="255" labelColorB="255" type="float" step="0.001" default="0" label="Slope" minimum="-999" labelColorG="255" maximum="999" varName="Slope" />
      <widget labelColorR="255" labelColorB="255" type="float" step="1" default="0" label="X" minimum="0" labelColorG="255" maximum="9999" varName="X" />
      <widget labelColorR="255" labelColorB="255" type="float" step="1" default="0" label="Y" minimum="0" labelColorG="255" maximum="9999" varName="Y" />
      <widget type="newLine" varName="0" />
      <widget labelColorR="255" labelColorB="255" type="float" step="0.01" default="0" label="Smoothnes" minimum="0" labelColorG="255" maximum="9999" varName="Smoothness" />
	<widget labelColorR="255" labelColorB="255" type="float" step="0.01" default="0" label="Line Opacity" minimum="0" labelColorG="255" maximum="1" varName="lineOpacity" />
	<widget labelColorR="255" labelColorB="255" type="float" step="0.5" default="2.5" label="Line Width" minimum="0" labelColorG="255" maximum="5" varName="lineSize" />

      <widget type="newLine" varName="0" />
    </group>
  </groups>
  <shaders vertex="fixed.vert" fragment="SPLIT.frag" />
</root>
