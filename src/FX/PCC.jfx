<?xml version = '1.0' encoding = 'UTF-8'?>
<root comment="this is the root node" >
  <general Description="Basic Primary Color Correction" menuName="Color/Primary Color Correction" author="Daniel Gollas" version="1.0" name="Primary Color Correction" />
  <groups>
    <group name="Parameters" >
      <widget type="newLine" varName="0" />
      <widget labelColorR="255" labelColorB="0" type="float" step="0.001" label="Brightness R" minimum="0" default="1" labelColorG="0" maximum="9999" varName="BrightnessR" />
      <widget labelColorR="0" labelColorB="0" type="float" step="0.001" label="Brightness G" minimum="0" default="1" labelColorG="255" maximum="9999" varName="BrightnessG" />
	<widget labelColorR="0" labelColorB="255" type="float" step="0.001" label="Brightness B" minimum="0" default="1" labelColorG="0" maximum="9999" varName="BrightnessB" />
      <widget type="newLine" varName="1" />

      <widget labelColorR="255" labelColorB="0" type="float" step="0.001" label="Contrast R" minimum="0" default="1" maximum="9999" labelColorG="0" varName="ContrastR" />

	<widget labelColorR="0" labelColorB="0" type="float" step="0.001" label="Contrast G" minimum="0" default="1" maximum="9999" labelColorG="255" varName="ContrastG" />

	<widget labelColorR="0" labelColorB="255" type="float" step="0.001" label="Contrast B" minimum="0" default="1" maximum="9999" labelColorG="0" varName="ContrastB" />

      <widget labelColorR="150" labelColorB="150" type="float" step="0.001" label="Average Y" minimum="0" default="0.5" maximum="1" labelColorG="150" varName="AvgLuminance" />

      <widget type="newLine" varName="2" />

      <widget labelColorR="255" labelColorB="0" type="float" step="0.001" label="SaturationR" minimum="0" default="1" maximum="9999" labelColorG="0" varName="SaturationR" />
	<widget labelColorR="0" labelColorB="0" type="float" step="0.001" label="SaturationG" minimum="0" default="1" maximum="9999" labelColorG="255" varName="SaturationG" />
	<widget labelColorR="0" labelColorB="255" type="float" step="0.001" label="SaturationB" minimum="0" default="1" maximum="9999" labelColorG="0" varName="SaturationB" />
      <widget type="newLine" varName="2" />
    </group>
  </groups>
  <shaders vertex="fixed.vert" fragment="PCC.frag" />
</root>
