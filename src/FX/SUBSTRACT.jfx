<?xml version = '1.0' encoding = 'UTF-8'?>
<root comment="this is the root node" >
  <general Description="Composite two images using a Substract operation" menuName="Comp/Substract" version="2.0" author="Daniel Gollas" name="Substract" />
  <groups>
    <group name="Parameters" >
      <widget type="newLine" varName="furstNeLine" />
      <widget labelColorR="255" labelColorB="255" type="texture" default="0" label="Bottom" labelColorG="255" varName="Bottom" />
      <widget labelColorR="255" labelColorB="255" type="texture" default="2" label="Top" labelColorG="255" varName="Top" />
      <widget labelColorR="255" labelColorB="255" type="bool" default="0" label="Absolut" labelColorG="255" varName="Absolut" />
      <widget type="newLine" varName="lastNewLine" />
    </group>
  </groups>
  <shaders vertex="fixed.vert" fragment="SUBSTRACT.frag" />
