header_name {.h} 
code_name {.cxx}
class LutWindow {open : {public Fl_Double_Window}
} {
  decl {\#include "UIConstants.h"} {}
  decl {\#include "UICallbacks.h"} {}
  Function {LutWindow(int x, int y, int wi, int height,const char* l) : Fl_Double_Window(300, 300, 300, 300, "Load Window")} {open
  } {
    Fl_Window lutWindow {
      label {LUT Manager}
      user_data LUTTYPE_ID
      callback lutCB open
      xywh {-575 466 510 500} type Double box NO_BOX color 56 labelcolor 17 non_modal size_range {510 500 510 500} visible
    } {
      Fl_Box {} {
        label label selected
        image {../CommonResources/JefeCheckDemoWaterMark.png} xywh {0 -12 512 512} box FLAT_BOX color 0
      }
    }
  }
} 
