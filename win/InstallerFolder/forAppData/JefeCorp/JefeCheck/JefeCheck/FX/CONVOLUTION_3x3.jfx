	  <widget type="float" step="0.001" default="0.00" label="1,2" minimum="-999" maximum="999" varName="k12" />
		<widget type="newLine" varName="1" />
	  <widget type="float" step="0.001" default="0.00" label="2,0" minimum="-999" maximum="999" varName="k20" />
