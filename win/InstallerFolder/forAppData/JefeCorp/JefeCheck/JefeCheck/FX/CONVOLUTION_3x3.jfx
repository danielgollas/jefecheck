<?xml version = '1.0' encoding = 'UTF-8'?>
<root comment="this is the root node" >
  <general Description="Apply a 3x3 Convolution" menuName="Special/Convolution 3x3" version="1.0" author="Daniel Gollas" name="Convolution 3x3" />
  <groups>
		
